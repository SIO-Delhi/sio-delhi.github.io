# =============================================================
# SIO Delhi Portal — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to git
# =============================================================

# Supabase (legacy — can be removed after full migration to PHP backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API URL
# For local dev: leave empty (Vite proxy handles /api → api.siodelhi.org)
# For production build: https://api.siodelhi.org
VITE_API_URL=

# Clerk Authentication
# Publishable key is safe to expose in frontend bundle
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key

# Clerk secret key — BACKEND ONLY, never expose to frontend
# This is used by api/.env, NOT by Vite
CLERK_SECRET_KEY=sk_live_your-clerk-secret-key
