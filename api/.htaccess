# Enable URL rewriting
RewriteEngine On

# Pass Authorization header to PHP (Apache/CGI strips it by default)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# If the request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route all other requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Set PHP settings (if allowed by your host)
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 16M
    php_value max_execution_time 300
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self' https://clerk.siodelhi.org https://api.clerk.com"

    # CORS headers for uploaded files (PDFs, images, audio)
    <FilesMatch "\.(pdf|jpg|jpeg|png|gif|webp|mp3|wav|ogg)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Disable PHP execution in uploads directory
<Directory "uploads">
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <FilesMatch "\.php$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</Directory>

# Prevent access to sensitive files
<FilesMatch "^(config|db)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to .env file
<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

# Block access to JWKS cache file
<Files ".clerk_jwks_cache.json">
    Order Allow,Deny
    Deny from all
</Files>
