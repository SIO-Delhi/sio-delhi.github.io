# =============================================================
# SIO Delhi API — Environment Variables
# Copy this file to api/.env and fill in your values
# NEVER commit api/.env with real secrets to git
# =============================================================

# Database credentials (MySQL on cPanel)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# URLs
BASE_URL=https://api.siodelhi.org
CORS_ORIGIN=https://sio-delhi.github.io

# Clerk JWT verification
CLERK_JWKS_URL=https://clerk.siodelhi.org/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_your-clerk-secret-key

# Optional: Static PEM key (avoids fetching JWKS if DNS not set)
# CLERK_PUBLIC_KEY_PEM=
